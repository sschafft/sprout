---
import BaseLayout from '@/layouts/BaseLayout.astro'
---

<BaseLayout title="Not found" description="This page doesn't exist.">
	<a slot="nav" class="plain accent" href="/">← Home</a>

	<section>
		<div class="eyebrow">404</div>
		<h1>Nothing here<span class="accent">.</span></h1>
		<p>That page has moved or never existed. <a href="/#work">See the work</a> instead.</p>
	</section>
</BaseLayout>

<style>
	section {
		padding: clamp(64px, 9vw, 104px) 0 56px;
		max-width: 860px;
	}

	.eyebrow {
		font-size: 13px;
		color: var(--muted);
		margin-bottom: 20px;
	}

	h1 {
		font-weight: 500;
		font-size: clamp(40px, 5.4vw, 60px);
		line-height: 1.06;
		letter-spacing: -0.025em;
		margin-bottom: 24px;
	}

	p {
		font-size: 20px;
		line-height: 1.55;
		color: var(--ink-2);
	}
</style>

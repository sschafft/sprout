---
import { Image } from 'astro:assets'
import KindTag from '@/components/KindTag.astro'
import ProjectPreview from '@/components/ProjectPreview.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getHome, getPeople, getProjects, getSite, splitAccentDot } from '@/lib/content'

const site = await getSite()
const home = await getHome()
const projects = await getProjects(site)
const people = (await getPeople(site, projects)).slice(0, home.people.limit ?? Infinity)

const headline = splitAccentDot(home.headline)
/** With featured projects the list starts short and a button shows the rest. */
const collapsed = projects.some((p) => p.entry.data.featured)
const groups = Object.entries(site.groups).filter(([id]) => projects.some((p) => p.entry.data.group === id))
---

<BaseLayout>
	<nav slot="nav" aria-label="Sections">
		{site.nav.map((item) => <a class="plain" href={item.href}>{item.label}</a>)}
	</nav>

	<section class="intro">
		<div class="hello">
			<Image class="photo" src={home.photo} alt={home.photoAlt} width={128} height={128} densities={[1, 2, 3]} loading="eager" />
			<h1>{headline.text}{headline.dot && <span class="accent">.</span>}</h1>
		</div>
		<div class="cards facts">
			{
				home.facts.map((fact) => (
					<div class="card">
						<div class="card-label">{fact.label}</div>
						<div class="card-text">{fact.text}</div>
					</div>
				))
			}
		</div>
	</section>

	<section id="experience">
		<div class="bar"><h2>{home.experience.heading}</h2></div>
		{
			home.experience.jobs.map((job) => (
				<div class="job">
					<span class="when">{job.years}</span>
					<span class="role">
						<strong>{job.role}</strong>
						<span>{job.org}</span>
					</span>
					<span class="note">{job.note}</span>
				</div>
			))
		}
		{
			home.experience.earlier.map((item) => (
				<div class="job">
					<span class="when">{home.experience.earlierLabel}</span>
					<span class="role">
						<strong>{item.title}</strong>
					</span>
					<span class="note">{item.note}</span>
					{item.href && (
						<a class="out plain accent" href={item.href} aria-label={`${item.title} website`}>
							↗
						</a>
					)}
				</div>
			))
		}
	</section>

	<section id="work" class:list={['block', { collapsed }]}>
		<div class="bar work-bar">
			<h2>{home.work.heading}</h2>
			<div class="filters" role="group" aria-label="Filter projects">
				<button type="button" data-filter="all" aria-pressed="true">{home.work.allLabel}</button>
				{
					groups.map(([id, group]) => (
						<button type="button" data-filter={id} aria-pressed="false">
							{group.label}
						</button>
					))
				}
			</div>
			<span class="count" aria-live="polite"><span data-count>{projects.length}</span> {home.work.countLabel}</span>
		</div>

		{
			projects.map(({ entry, n, href }, i) => {
				const p = entry.data
				const firstInGroup = i === 0 || projects[i - 1]!.entry.data.group !== p.group
				return (
					<>
						{firstInGroup && (
							<div class="group-head" data-group-head={p.group} data-more>
								<span class="accent">{site.groups[p.group]!.label}</span>
								<span>{site.groups[p.group]!.note}</span>
							</div>
						)}
						<article class="project" data-group={p.group} data-more={collapsed && !p.featured ? '' : undefined}>
							<span class="n">{n}</span>
							<a class="thumb" href={href} tabindex="-1" aria-hidden="true">
								<ProjectPreview project={entry} variant="thumb" eager={p.featured} />
							</a>
							<div class="what">
								<h3>
									<a class="plain" href={href}>
										{p.title}
									</a>
								</h3>
								<div class="org">{p.org}</div>
								<KindTag kind={p.kind} label={site.kinds[p.kind]!} />
							</div>
							<div class="why">
								<p>{p.blurb}</p>
								<div class="links">
									<a class="accent" href={href}>
										Case study →<span class="sr-only">: {p.title}</span>
									</a>
									{p.links.map((link) => (
										<a href={link.href}>{link.label}</a>
									))}
								</div>
							</div>
							<span class="years">{p.years}</span>
						</article>
					</>
				)
			})
		}

		{
			collapsed && (
				<button type="button" class="more" data-more-button>
					{home.work.moreLabel} {projects.length} {home.work.countLabel} →
				</button>
			)
		}
	</section>

	<noscript>
		<style>
			/* Without JavaScript the "Show all" button cannot work, so list everything. */
			#work.collapsed .project[data-more] {
				display: grid;
			}
			#work.collapsed .group-head[data-more] {
				display: flex;
			}
			#work.collapsed .count {
				display: inline;
			}
			#work .more {
				display: none;
			}
		</style>
	</noscript>

	<section id="people" class="block">
		<div class="bar">
			<h2>{home.people.heading}</h2>
			<span class="bar-note">{home.people.intro}</span>
		</div>
		<ul class="people">
			{
				people.map((person) => (
					<li class="person">
						{person.href ? (
							<a class="person-name plain" href={person.href}>
								{person.name} ↗
							</a>
						) : (
							<div class="person-name">{person.name}</div>
						)}
						<div class="chips">
							{person.chips.map((chip) =>
								chip.href ? (
									<a class="chip linked" href={chip.href}>
										{chip.title}
									</a>
								) : (
									<span class="chip">{chip.title}</span>
								)
							)}
						</div>
					</li>
				))
			}
		</ul>
		<div class="thanks">
			<div class="thanks-text">
				<div class="thanks-label">{home.people.thanksLabel}</div>
				<div>{home.people.thanksText}</div>
			</div>
			<div class="family">
				{home.people.family.map((name) => <span>{name}</span>)}
			</div>
		</div>
	</section>

	<section class="block about">
		<h2>{home.about.heading}</h2>
		<p>{home.about.text}</p>
	</section>
</BaseLayout>

<script>
	// Work list: "Show all" and the group filter. Without JavaScript every project simply stays visible.
	const work = document.getElementById('work')
	const more = document.querySelector<HTMLButtonElement>('[data-more-button]')
	const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]')
	const rows = document.querySelectorAll<HTMLElement>('[data-group]')
	const heads = document.querySelectorAll<HTMLElement>('[data-group-head]')
	const count = document.querySelector('[data-count]')

	const expand = () => work?.classList.remove('collapsed')

	more?.addEventListener('click', () => {
		expand()
		// Put focus on the first newly revealed project so keyboard users land in the list.
		document.querySelector<HTMLAnchorElement>('.project[data-more] h3 a')?.focus()
	})

	buttons.forEach((button) =>
		button.addEventListener('click', () => {
			expand()
			const filter = button.dataset.filter
			const all = filter === 'all'
			let shown = 0
			buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)))
			rows.forEach((row) => {
				row.hidden = !all && row.dataset.group !== filter
				if (!row.hidden) shown++
			})
			// Group headings only make sense when every group is listed.
			heads.forEach((head) => (head.hidden = !all))
			if (count) count.textContent = String(shown)
		})
	)
</script>

<style>
	nav {
		display: flex;
		gap: 24px;
	}

	nav a {
		color: var(--muted);
	}

	nav a:hover {
		color: var(--accent);
	}

	.intro {
		padding: clamp(64px, 9vw, 112px) 0 72px;
	}

	h1 {
		font-weight: 500;
		font-size: clamp(40px, 5.4vw, 64px);
		line-height: 1.06;
		letter-spacing: -0.025em;
		max-width: 980px;
		text-wrap: balance;
	}

	.hello {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 20px clamp(20px, 3.4vw, 44px);
		margin-bottom: 40px;
	}

	.hello h1 {
		flex: 1 1 320px;
	}

	.hello :global(.photo) {
		flex: none;
		width: clamp(88px, 10vw, 128px);
		height: auto;
		aspect-ratio: 1;
		border-radius: 50%;
		object-fit: cover;
		filter: grayscale(1);
	}

	.facts {
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
	}

	.facts .card {
		padding: 18px 20px;
	}

	.facts .card-text {
		font-size: 16px;
	}

	.block {
		margin-top: var(--section-gap);
	}

	/* Work */
	.work-bar {
		align-items: center;
		gap: 8px 16px;
	}

	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.filters button {
		cursor: pointer;
		font: inherit;
		font-size: 13.5px;
		padding: 6px 14px;
		border-radius: var(--pill);
		border: 0;
		background: var(--surface-2);
		color: var(--ink-2);
	}

	.filters button[aria-pressed='true'] {
		background: var(--accent);
		color: var(--bg);
	}

	.count {
		margin-left: auto;
		font-size: 13px;
		color: var(--muted);
		white-space: nowrap;
	}

	.group-head {
		display: flex;
		gap: 10px;
		align-items: baseline;
		flex-wrap: wrap;
		padding: 28px 0 10px;
		border-top: 1px solid var(--line);
		font-size: 13px;
		color: var(--muted);
	}

	.group-head .accent {
		font-weight: 500;
	}

	.project,
	.job {
		display: grid;
		grid-template-columns: 32px 180px minmax(0, 1fr) minmax(0, 1.5fr) 64px;
		gap: var(--col-gap);
		border-top: 1px solid var(--line);
	}

	.project {
		padding: 20px 0;
		align-items: start;
	}

	[hidden] {
		display: none !important;
	}

	.collapsed [data-more],
	.collapsed .count {
		display: none;
	}

	.more {
		display: block;
		width: 100%;
		cursor: pointer;
		font: inherit;
		font-size: 14px;
		font-weight: 500;
		text-align: left;
		color: var(--accent);
		background: none;
		border: 0;
		border-top: 1px solid var(--line);
		padding: 20px 0 4px calc(32px + var(--col-gap));
	}

	.more:hover {
		text-decoration: underline;
	}

	#work:not(.collapsed) .more {
		display: none;
	}

	.n {
		font-size: 13px;
		color: var(--muted);
		padding-top: 3px;
	}

	.thumb {
		display: block;
	}

	h3 {
		margin: 0 0 6px;
		font-size: 21px;
		font-weight: 500;
		letter-spacing: -0.01em;
		line-height: 1.25;
	}

	.org {
		font-size: 13.5px;
		color: var(--muted);
		margin-bottom: 10px;
		line-height: 1.4;
	}

	.why p {
		margin-bottom: 10px;
		font-size: 15px;
		line-height: 1.6;
		color: var(--ink-2);
		text-wrap: pretty;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 6px 18px;
		font-size: 14px;
		font-weight: 500;
	}

	.links a {
		color: var(--muted);
	}

	.links a.accent,
	.links a:hover {
		color: var(--accent);
	}

	.years {
		font-size: 14px;
		text-align: right;
		color: var(--muted);
		padding-top: 3px;
	}

	/* Experience */
	.job {
		padding: 16px 0;
		font-size: 15px;
		line-height: 1.5;
	}

	.when {
		grid-column: 2;
		color: var(--muted);
	}

	.role strong {
		display: block;
		font-weight: 500;
	}

	.role span {
		color: var(--muted);
	}

	.note {
		color: var(--ink-2);
	}

	.out {
		text-align: right;
	}

	/* People */
	.people {
		list-style: none;
		margin: 0;
		padding: 8px 0 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: 12px;
	}

	.person {
		background: var(--surface);
		border-radius: var(--radius);
		padding: 16px 18px;
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.person-name {
		font-size: 16px;
		font-weight: 500;
	}

	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin-top: 4px;
	}

	.chips .chip {
		font-size: 12px;
		color: var(--ink-2);
		background: var(--surface-2);
		padding: 3px 10px;
	}

	.chips .chip.linked {
		color: var(--accent);
		background: var(--accent-soft);
	}

	.chips .chip.linked:hover {
		background: rgba(232, 197, 71, 0.22);
	}

	.thanks {
		margin-top: 12px;
		border-radius: var(--radius);
		padding: 22px 24px;
		background:
			linear-gradient(var(--surface), var(--surface)) padding-box,
			linear-gradient(90deg, var(--accent), var(--kind-live), var(--kind-client)) border-box;
		border: 1px solid transparent;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 14px 28px;
	}

	.thanks-text {
		flex: 1 1 320px;
		min-width: 0;
		font-size: 17px;
		line-height: 1.45;
	}

	.thanks-label {
		font-size: 12px;
		color: var(--accent);
		margin-bottom: 6px;
	}

	.family {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.family span {
		font-size: 15px;
		font-weight: 500;
		color: var(--bg);
		background: var(--accent);
		border-radius: var(--pill);
		padding: 6px 16px;
	}

	/* About */
	.about {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
		gap: 32px;
		padding: 16px 0;
		border-top: 1px solid var(--line-strong);
	}

	.about h2 {
		font-size: 20px;
		font-weight: 600;
	}

	.about p {
		font-size: 16px;
		line-height: 1.65;
		color: var(--ink-2);
		max-width: 640px;
		text-wrap: pretty;
	}

	@media (max-width: 820px) {
		.project {
			grid-template-columns: 32px minmax(0, 1fr) auto;
			grid-template-areas:
				'n what years'
				'. thumb thumb'
				'. why why';
			row-gap: 14px;
		}

		.n {
			grid-area: n;
		}

		.thumb {
			grid-area: thumb;
		}

		.what {
			grid-area: what;
		}

		.why {
			grid-area: why;
		}

		.years {
			grid-area: years;
		}

		.job {
			grid-template-columns: minmax(0, 1fr) auto;
			row-gap: 4px;
		}

		.when,
		.role,
		.note {
			grid-column: 1;
		}

		.out {
			grid-column: 2;
			grid-row: 1;
		}

		.about {
			grid-template-columns: minmax(0, 1fr);
			gap: 12px;
		}

		.more {
			padding-left: 0;
		}
	}
</style>

---
import { getEntry, render } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { splitAccentDot } from '@/lib/content'

const page = await getEntry('pages', 'about')
if (!page) throw new Error('src/content/pages/about.md is missing')

const { Content } = await render(page)
const heading = splitAccentDot(page.data.heading)
---

<BaseLayout title={page.data.title} description={page.data.description} pandaLink={false}>
	<a slot="nav" class="plain accent" href="/">← Home</a>

	<header class="intro">
		<div class="eyebrow">{page.data.eyebrow}</div>
		<h1>{heading.text}{heading.dot && <span class="accent">.</span>}</h1>
		<p class="lede">{page.data.lede}</p>
	</header>

	<div class="prose"><Content /></div>

	<div class="cards more">
		{
			page.data.cards.map((card) =>
				card.href ? (
					<a class="card" href={card.href}>
						<div class="card-label">{card.label}</div>
						<div class="card-text">{card.text}</div>
					</a>
				) : (
					<div class="card">
						<div class="card-label">{card.label}</div>
						<div class="card-text">{card.text}</div>
					</div>
				)
			)
		}
	</div>
</BaseLayout>

<style>
	.intro {
		padding: clamp(64px, 9vw, 104px) 0 56px;
		max-width: 860px;
	}

	.eyebrow {
		font-size: 13px;
		color: var(--muted);
		margin-bottom: 20px;
	}

	h1 {
		font-weight: 500;
		font-size: clamp(40px, 5.4vw, 60px);
		line-height: 1.06;
		letter-spacing: -0.025em;
		margin-bottom: 24px;
		text-wrap: balance;
	}

	.lede {
		font-size: 20px;
		line-height: 1.55;
		color: var(--ink-2);
		text-wrap: pretty;
	}

	.more {
		margin-top: 80px;
	}

	.more .card {
		padding: 18px 20px;
	}
</style>

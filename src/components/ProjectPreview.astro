---
import { Image } from 'astro:assets'
import PelicashMock from '@/components/PelicashMock.astro'
import type { Project } from '@/lib/content'

interface Props {
	project: Project
	/** `thumb` is the small, non-interactive work list tile; `hero` leads a case study. */
	variant: 'thumb' | 'hero'
}

const { project, variant } = Astro.props
const { title, hero, mock } = project.data
const thumb = variant === 'thumb'
---

<div class:list={['preview', variant]}>
	{
		hero ? (
			<Image
				src={hero}
				alt={thumb ? '' : `${title} preview`}
				widths={thumb ? [180, 360, 720] : [640, 1152, 1600, 2304]}
				sizes={thumb ? '(max-width: 820px) 100vw, 180px' : '(max-width: 1280px) 100vw, 1152px'}
				loading={thumb ? 'lazy' : 'eager'}
			/>
		) : mock === 'pelicash' ? (
			<PelicashMock inert={thumb} />
		) : (
			<span class="empty">{title}</span>
		)
	}
</div>

<style>
	.preview {
		aspect-ratio: 16 / 10;
		background: var(--surface-2);
		overflow: hidden;
		position: relative;
	}

	.thumb {
		border-radius: var(--radius-sm);
	}

	.hero {
		border-radius: var(--radius);
	}

	.preview :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.empty {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		padding: 12px;
		text-align: center;
		font-size: 12px;
		color: var(--muted);
	}
</style>
